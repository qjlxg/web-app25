{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app25",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fe938587-ac73-4840-856f-077948947d6b","database_name": "nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f798beabc45b466fbba69f216238dd52" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
